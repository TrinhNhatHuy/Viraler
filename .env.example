# --- Supabase (values from `pnpm supabase status` for local dev) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server/worker only, never in client code

# Worker's direct Postgres connection (local Supabase default port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase URL as seen by servers (web server + worker). Optional for local dev;
# docker-compose points it at host.docker.internal.
SUPABASE_URL=http://127.0.0.1:54321

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
# Model files (downloaded once into MODELS_DIR, ~830 MB with the defaults)
MODELS_DIR=./models
# Kokoro TTS variant: fp32 (best, 325 MB) | int8 (smaller/faster) | fp16
KOKORO_MODEL=fp32
# Whisper captions model: small.en (484 MB, better timing) | base.en (145 MB, faster)
WHISPER_MODEL=small.en

# --- Stock media ---
# Free key: https://www.pexels.com/api/ (worker only; 200 requests/hour). Without it,
# stock search reports "isn't set up"; uploads still work.
PEXELS_API_KEY=
